# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/evently?schema=public"

# Secret used to sign JWT tokens
JWT_SECRET="your-secret-key"

# JWT expiration time
JWT_EXPIRES_IN="7d"

# Port where the Express server listens
PORT=3000

# Optional AI configuration (OpenAI-compatible chat completions API)
# Leave AI_API_KEY empty to use the built-in fallback recommendation.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Google Maps Platform (opcional en backend). El autocompletado se usa en el frontend,
# por lo que normalmente basta con VITE_GOOGLE_MAPS_API_KEY en frontend/.env.
GOOGLE_MAPS_API_KEY=""

# Email (SMTP con Nodemailer). Si EMAIL_HOST está vacío, no se envían correos
# y el registro se completa igual (emailSent = false).
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="Evently <no-reply@evently.com>"
