# Base URL of the Evently REST API
VITE_API_URL="http://localhost:3000/api"

# Google Maps Platform API key (Places Autocomplete).
# Create it in https://console.cloud.google.com/google/maps-apis/credentials
# and enable the "Places API (New)" + "Maps JavaScript API". Restrict it by
# HTTP referrer (e.g. http://localhost:5173/*). Leave empty to disable autocomplete.
VITE_GOOGLE_MAPS_API_KEY=""
